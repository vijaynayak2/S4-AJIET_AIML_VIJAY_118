
import java.util.*;
class Main {
    public static void main(String[] args) { 
    int[] num = {70,50,30,40,10};
        int min =num[0];
        int max = num[0];
        for (int i = 1; i < num.length; i++) 
        {
            if (num[i] < min) min = num[i];
            if (num[i] > max) max = num[i];
}
        System.out.println("Minimum value: " + min);
        System.out.println("Maximum value: " + max);
    }
}    
        
        
